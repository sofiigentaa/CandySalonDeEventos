# Copiá este archivo a .env para desarrollo. Nunca subas el .env a GitHub.

# Base de datos (Supabase → Connect → Session pooler). Sin esta variable el
# sistema corre en modo demo, con los datos en memoria.
DATABASE_URL="postgresql://postgres.<ref>:<CLAVE>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Acceso al sistema
SALON_PASSWORD="una-clave-de-al-menos-12-caracteres"
SALON_EMAILS="duena@gmail.com"
SESSION_SECRET="generar-con: openssl rand -hex 32"

# Opcional: IA para redactar contratos
GEMINI_API_KEY=""

# Solo para demos: habilita "Vaciar todo" / "Datos de ejemplo" y carga ejemplos en una base vacía
ALLOW_DEMO_RESET="false"
SEED_DEMO="false"
