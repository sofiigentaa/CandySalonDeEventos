# Copiá este archivo a .env para desarrollo. Nunca subas el .env a GitHub.

# PostgreSQL local privado: inicializarlo siguiendo DEPLOY.md.
# Cambiar "tu-usuario" por tu usuario de Linux en la ruta del socket.
SQL_HOST=/home/tu-usuario/.local/share/postgresql/candy-salon/socket
SQL_USER=candy_app
SQL_PASSWORD=
SQL_DB_NAME=candy_salon_eventos
SQL_PORT=55432
DB_SSL=false

# Opcional: IA para redactar contratos
GEMINI_API_KEY=

# Solo para demos: habilita "Vaciar todo" / "Datos de ejemplo".
ALLOW_DEMO_RESET="false"

# Supabase se usa únicamente para Auth; no se necesita su PostgreSQL.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
